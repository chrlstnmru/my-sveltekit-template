    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-svelte": "^3.15.0",
    "formsnap": "^2.0.1",
    "globals": "^16.5.0",
    "jsrepo": "^3.5.0",
    "layerchart": "2.0.0-next.43",
    "mode-watcher": "^1.1.0",
